generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserTier {
  FREE
  PRO
  ENTERPRISE
}

enum SharePermission {
  READ
  UPLOAD
  DELETE
  SHARE
}

enum UploadStatus {
  PENDING
  COMPLETED
  PENDING_COMPRESSION
}

enum IndexingJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  NOT_ELIGIBLE
}

model User {
  id               String   @id @default(cuid())
  cognitoSub       String   @unique @map("cognito_sub")
  email            String   @unique
  tier             UserTier @default(FREE)
  storageUsedBytes BigInt   @default(0) @map("storage_used_bytes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  files      File[]     @relation("OwnedFiles")
  shares     Share[]    @relation("ShareOwner")

  @@map("users")
}

model File {
  id           String       @id @default(cuid())
  ownerId      String       @map("owner_id")
  parentId     String?      @map("parent_id")
  name         String
  s3Key        String?      @map("s3_key")
  previewS3Key String?      @map("preview_s3_key")
  mimeType     String?      @map("mime_type")
  sizeBytes    BigInt       @default(0) @map("size_bytes")
  isFolder     Boolean      @default(false) @map("is_folder")
  uploadStatus UploadStatus @default(PENDING) @map("upload_status")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  owner    User   @relation("OwnedFiles", fields: [ownerId], references: [id], onDelete: Cascade)
  parent   File?  @relation("FileHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children File[] @relation("FileHierarchy")
  shares   Share[]
  chunks   DocumentChunk[]

  @@index([ownerId, parentId])
  @@map("files")
}

model Share {
  id            String            @id @default(cuid())
  resourceId    String            @map("resource_id")
  ownerId       String            @map("owner_id")
  granteeEmail  String            @map("grantee_email")
  granteeUserId String?           @map("grantee_user_id")
  permissions   SharePermission[]
  createdAt     DateTime          @default(now()) @map("created_at")

  resource File @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  owner    User @relation("ShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([resourceId, granteeEmail])
  @@map("shares")
}

model IndexingJob {
  id           String            @id @default(cuid())
  jobKey       String            @unique @map("job_key")
  fileId       String            @map("file_id")
  ownerId      String            @map("owner_id")
  sourceBucket String?           @map("source_bucket")
  sourceKey    String?           @map("source_key")
  status       IndexingJobStatus @default(PENDING)
  reason       String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  chunks DocumentChunk[]

  @@index([status, updatedAt])
  @@index([ownerId, fileId])
  @@map("indexing_jobs")
}

model DocumentChunk {
  id             String                      @id @default(cuid())
  indexingJobId  String                      @map("indexing_job_id")
  fileId         String                      @map("file_id")
  ownerId        String                      @map("owner_id")
  sourceFileName String                      @map("source_file_name")
  chunkIndex     Int                         @map("chunk_index")
  chunkText      String
  embedding      Unsupported("vector")?
  embeddingModel String?                     @map("embedding_model")
  vectorDocId    String?                     @map("vector_doc_id")
  lastIndexedAt  DateTime                    @default(now()) @map("last_indexed_at")
  createdAt      DateTime                    @default(now()) @map("created_at")

  indexingJob IndexingJob @relation(fields: [indexingJobId], references: [id], onDelete: Cascade)
  file        File        @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([ownerId, fileId])
  @@index([vectorDocId])
  @@map("document_chunks")
}
