generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserTier {
  FREE
  PRO
  ENTERPRISE
}

enum UploadStatus {
  PENDING
  COMPLETED
  PENDING_COMPRESSION
}

enum CompressionJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id               String   @id @default(cuid())
  cognitoSub       String   @unique @map("cognito_sub")
  email            String   @unique
  tier             UserTier @default(FREE)
  storageUsedBytes BigInt   @default(0) @map("storage_used_bytes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  files File[] @relation("OwnedFiles")

  @@map("users")
}

model File {
  id           String       @id @default(cuid())
  ownerId      String       @map("owner_id")
  parentId     String?      @map("parent_id")
  name         String
  s3Key        String?      @map("s3_key")
  previewS3Key String?      @map("preview_s3_key")
  mimeType     String?      @map("mime_type")
  sizeBytes    BigInt       @default(0) @map("size_bytes")
  isFolder     Boolean      @default(false) @map("is_folder")
  uploadStatus UploadStatus @default(PENDING) @map("upload_status")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  owner User @relation("OwnedFiles", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, parentId])
  @@map("files")
}

model InternalService {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("internal_services")
}

model InternalClient {
  id          String   @id @default(cuid())
  clientId    String   @unique @map("client_id")
  name        String
  secretHash  String   @map("secret_hash")
  permissions String[] @default([])
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("internal_clients")
}

model CompressionJob {
  id            String                 @id @default(cuid())
  jobKey        String                 @unique @map("job_key")
  fileId        String?                @map("file_id")
  sourceBucket  String?                @map("source_bucket")
  sourceKey     String?                @map("source_key")
  status        CompressionJobStatus   @default(PENDING)
  previewS3Key  String?                @map("preview_s3_key")
  previewS3Url  String?                @map("preview_s3_url")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@index([status, updatedAt])
  @@map("compression_jobs")
}

