# Copy to .env.aws-smoke and fill in with a dedicated AWS test stage's values
# (e.g. dev-e2e). Never point this at production. See apps/api/test/aws/README.md.

AWS_TEST_MODE=true

# Deployed API base URL (ApiUrl CDK output)
AWS_TEST_API_URL=https://api.dev-e2e.example.com

AWS_TEST_REGION=us-east-1

# Cognito (UserPoolId / UserPoolClientId CDK outputs)
AWS_TEST_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
AWS_TEST_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# A dedicated Cognito test user with USER_PASSWORD_AUTH enabled on the app client
AWS_TEST_COGNITO_USERNAME=aws-smoke-test@example.com
AWS_TEST_COGNITO_PASSWORD=changeme

# S3 buckets (FilesBucketName / PreviewsBucketName CDK outputs)
AWS_TEST_FILES_BUCKET=cloudbyte-dev-e2e-files
AWS_TEST_PREVIEWS_BUCKET=cloudbyte-dev-e2e-previews
